{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfprojecte2evb"
		},
		"ADLSG2_SFTP_DATA_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ADLSG2_SFTP_DATA'"
		},
		"LS_OUTPUT_SFTP_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_OUTPUT_SFTP'"
		},
		"LS_SQL_SERVER_INPUT_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQL_SERVER_INPUT'"
		},
		"SQL_OUTPUT_PARQUET_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'SQL_OUTPUT_PARQUET'"
		},
		"ADLSG2_SFTP_DATA_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adfe2eproject.dfs.core.windows.net/"
		},
		"LS_OUTPUT_SFTP_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://accountforoutput01.dfs.core.windows.net/"
		},
		"LS_SQL_SERVER_INPUT_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"LS_SQL_SERVER_INPUT_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "vbadfproject"
		},
		"LS_SQL_SERVER_INPUT_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "ismahil_4338"
		},
		"RestService1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://retoolapi.dev/iXyaxb/data"
		},
		"SQL_OUTPUT_PARQUET_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://accountforoutput01.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfprojecte2evb_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ADLSG2_SFTP_DATA_accountKey": {
						"value": "[parameters('ADLSG2_SFTP_DATA_accountKey')]"
					},
					"LS_OUTPUT_SFTP_accountKey": {
						"value": "[parameters('LS_OUTPUT_SFTP_accountKey')]"
					},
					"SQL_OUTPUT_PARQUET_accountKey": {
						"value": "[parameters('SQL_OUTPUT_PARQUET_accountKey')]"
					},
					"LS_SQL_SERVER_INPUT_password": {
						"value": "[parameters('LS_SQL_SERVER_INPUT_password')]"
					},
					"ADLSG2_SFTP_DATA_properties_typeProperties_url": {
						"value": "[parameters('ADLSG2_SFTP_DATA_properties_typeProperties_url')]"
					},
					"LS_OUTPUT_SFTP_properties_typeProperties_url": {
						"value": "[parameters('LS_OUTPUT_SFTP_properties_typeProperties_url')]"
					},
					"RestService1_properties_typeProperties_url": {
						"value": "[parameters('RestService1_properties_typeProperties_url')]"
					},
					"SQL_OUTPUT_PARQUET_properties_typeProperties_url": {
						"value": "[parameters('SQL_OUTPUT_PARQUET_properties_typeProperties_url')]"
					},
					"LS_SQL_SERVER_INPUT_properties_typeProperties_server": {
						"value": "[parameters('LS_SQL_SERVER_INPUT_properties_typeProperties_server')]"
					},
					"LS_SQL_SERVER_INPUT_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_SERVER_INPUT_properties_typeProperties_database')]"
					},
					"LS_SQL_SERVER_INPUT_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL_SERVER_INPUT_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}